# 测试 / 诊断的临时产物
.tmp*
# 调参 / 验收用的静态样张（artifacts/*.png|svg）：本地生成，不入库
artifacts/
# 听音成谱已移除，本机若残留模型运行时目录仍不入库
.lab-runtime/
*.log
.codebuddy

# 本机数据：曲库文件夹（谱面 + 伴奏音频，个人数据不上传）与原始歌曲
Score/
music/
__pycache__/

# 构建产物（msi / exe / apk）只留本机，不入库
*.msi
*.exe
*.apk

# 签名凭据：只留本机，绝不入库（丢了可以用 keytool 重新生成，但包名一致即可继续更新）
android/windscore.keystore
