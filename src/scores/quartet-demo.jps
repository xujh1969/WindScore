@format 3
@title 小星星
@sub 四声部合奏示例 · 旋律、和声、分解和弦与低音
@key 1=C
@beat 4/4
@bpm 96
@patch 73

@part 1 "主旋律"
@mix 1 on all
mf (1 1 5 5) | (6 6 5-) | (4 4 3 3) | (2 2 1-) | 换行
(5 5 4 4) | (3 3 2-) | (5 5 4 4) | (3 3 2-) | 换行
(1 1 5 5) | (6 6 5-) | (4 4 3 3) | (2 2 1-) ||

@part 2 "和声"
@mix 0.65 on all
p 3- 3- | 4- 3- | 1- 1- | 7v- 1- |
3- 2- | 1- 7v- | 3- 2- | 1- 7v- |
3- 3- | 4- 3- | 1- 1- | 7v- 1- ||

@part 3 "分解和弦"
@mix 0.5 on all
p 1v/ 3v/ 5v/ 3v/ 1v/ 3v/ 5v/ 3v/ | 4v/ 6v/ 1/ 6v/ 1v/ 3v/ 5v/ 3v/ |
4v/ 6v/ 1/ 6v/ 1v/ 3v/ 5v/ 3v/ | 5v/ 7v/ 2/ 7v/ 1v/ 3v/ 5v/ 3v/ |
1v/ 3v/ 5v/ 3v/ 5v/ 7v/ 2/ 7v/ | 1v/ 3v/ 5v/ 3v/ 5v/ 7v/ 2/ 7v/ |
1v/ 3v/ 5v/ 3v/ 5v/ 7v/ 2/ 7v/ | 1v/ 3v/ 5v/ 3v/ 5v/ 7v/ 2/ 7v/ |
1v/ 3v/ 5v/ 3v/ 1v/ 3v/ 5v/ 3v/ | 4v/ 6v/ 1/ 6v/ 1v/ 3v/ 5v/ 3v/ |
4v/ 6v/ 1/ 6v/ 1v/ 3v/ 5v/ 3v/ | 5v/ 7v/ 2/ 7v/ 1v- ||

@part 4 "低音"
@mix 0.7 on all
p 1vv--- | 4vv- 1vv- | 4vv- 1vv- | 5vv- 1vv- |
1vv- 5vv- | 1vv- 5vv- | 1vv--- | 0 5vv-- |
1vv--- | 4vv- 1vv- | 4vv- 1vv- | 5vv- 1vv- ||
